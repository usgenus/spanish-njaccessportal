DirectoryIndex index.php index.html

<IfModule mod_headers.c>
  Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
  Header set Pragma "no-cache"
  Header set Expires 0
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Admin clean URL
RewriteRule ^admin/?$ admin/index.php [L]

# Protect data folder
RewriteRule ^data/.*$ - [F,L]

# Clean URL rewrites for Spanish portal
RewriteRule ^noticias(\.html)?$ noticias.php [L]
RewriteRule ^medicare/?$ medicare.html [L]
RewriteRule ^about/?$ about.html [L]
RewriteRule ^servicio-premium/?$ servicio-premium-de-navegacion-y-acceso-a-la-salud.html [L]
RewriteRule ^tool/?$ tool.html [L]

# Article Clean URLs
RewriteRule ^noticias/([^/]+)/?$ blog-post.php?slug=$1 [L]
RewriteRule ^blog/([^/]+)/?$ blog-post.php?slug=$1 [L]
RewriteRule ^articulo/([^/]+)/?$ blog-post.php?slug=$1 [L]

# If requested file or directory exists, serve it
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Dynamic fallback for article slugs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^noticia/([^/]+)/?$ blog-post.php?slug=$1 [L]

</IfModule>
